<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CLOCK SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARS COORDINATED TIME"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/mtcTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="48sp"
            android:textColor="@color/accent"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/earthUtc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/todaySol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/primary_dark"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALENDAR"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/yearHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/monthsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/primary_dark"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/curiositySol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/perseveranceSol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
